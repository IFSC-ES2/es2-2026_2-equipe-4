# Copie para .env na raiz antes de executar Docker Compose.
MONGO_ROOT_USERNAME=publicaifsc_local
MONGO_ROOT_PASSWORD=troque_esta_senha_local
MONGO_DATABASE=publicaifsc
MONGO_PORT=27017

# Segredo aleatório com pelo menos 32 bytes para assinatura JWT HS256.
JWT_SECRET=o_rato_roeu_a_roupa_do_rei_de_roma_ifsc_sao_jose
JWT_EXPIRATION_MS=3600000

# Popula projetos fictícios apenas quando o banco está vazio.
APP_SEED_PROJETOS_ENABLED=false

BACKEND_PORT=8080
FRONTEND_PORT=5173

# URL que o navegador usa para alcançar a API; não use o hostname interno "backend" aqui.
VITE_API_BASE_URL=http://localhost:8080
